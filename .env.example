#--------------------------------------------------------------------
# DIFOSS Rangkui - Emerald Forest Edition
# Environment Configuration Template
# 
# CARA PAKAI:
# 1. Copy file ini menjadi .env
# 2. Isi nilai-nilai sesuai environment Anda
# 3. JANGAN commit file .env ke repository!
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# APP SETTINGS
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

# ⚠️ GANTI sesuai environment Anda:
# - Laragon (rangkui.test): http://rangkui.test/
# - Localhost biasa: http://localhost/Rangkui/public/
# - Production: https://rangkui.perpustakaan.ac.id/
app.baseURL = 'http://rangkui.test/'
app.indexPage = ''

# SECURITY: Set true di production untuk force HTTPS
app.forceGlobalSecureRequests = false

app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ci_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

# SECURITY: Enable di production
app.CSRFProtection = false
app.CSRFTokenName = 'csrf_test_name'
app.CSRFCookieName = 'csrf_cookie_name'
app.CSRFExpire = 7200
app.CSRFRegenerate = true
app.CSRFRedirect = false
app.CSRFSameSite = 'Lax'
app.CSPEnabled = false

app.defaultLocale = 'id'
app.negotiateLocale = false
app.supportedLocales = "['en', 'id']"

#--------------------------------------------------------------------
# DATABASE SETTINGS
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = rangkui
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.foreignKeys = true

database.tests.hostname = localhost
database.tests.database = rangkui_test
database.tests.username = root
database.tests.password = ''
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.port = 3306

#--------------------------------------------------------------------
# SECURITY / ENCRYPTION
#--------------------------------------------------------------------
# ⚠️ WAJIB: Generate dengan perintah: php spark key:generate
# Jangan biarkan kosong di production!
encryption.key =

encryption.driver = OpenSSL
encryption.blockSize = 16
encryption.digest = SHA512

#--------------------------------------------------------------------
# RECAPTCHA (Google v2)
#--------------------------------------------------------------------
recaptcha.siteKey = ''
recaptcha.secretKey = ''

#--------------------------------------------------------------------
# GEMINI AI API (Untuk fitur ekstraksi PDF)
#--------------------------------------------------------------------
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = ''

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------
logger.threshold = 9
logger.path =
logger.fileExtension =
logger.filePermissions = 0644
logger.date.format = 'Y-m-d H:i:s'